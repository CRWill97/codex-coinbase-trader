OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Coinbase CDP Secret API Key. Keep private keys local and never commit them.
COINBASE_API_KEY=
COINBASE_API_SECRET=
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
COINBASE_USE_SANDBOX=false

# Start in paper mode. Set live mode only after completing paper-trading validation.
TRADER_MODE=paper
TRADER_PRODUCT_ID=BTC-USD
TRADER_PRODUCT_IDS=BTC-USD,ETH-USD,SOL-USD
TRADER_CANDLE_GRANULARITY=ONE_HOUR
TRADER_LOOKBACK_CANDLES=48
TRADER_LOOP_SECONDS=3600
TRADER_MAX_TRADES_PER_CYCLE=2
TRADER_AGGRESSIVE_MODE=false
TRADER_AGGRESSIVE_SIZE_MULTIPLIER=1.40
TRADER_AGGRESSIVE_HOLD_TO_TRADE_EDGE_BPS=180
TRADER_PROBE_TRADE_ON_ALL_HOLD=false
TRADER_PROBE_TRADE_NOTIONAL=2
TRADER_STOP_LOSS_PCT=0.03
TRADER_PAPER_STARTING_CASH=100

TRADER_MAX_NOTIONAL_PER_TRADE=5
TRADER_MAX_POSITION_NOTIONAL=15
TRADER_MAX_DAILY_LOSS=10
TRADER_MAX_DRAWDOWN_PCT=0.12
TRADER_MAX_SLIPPAGE_BPS=35
TRADER_MIN_CONFIDENCE=0.62
TRADER_FEE_BPS=60
TRADER_MIN_EXPECTED_EDGE_BPS=20
TRADER_MAX_TRADES_PER_DAY=8
TRADER_MIN_MINUTES_BETWEEN_TRADES=30
TRADER_VOLATILITY_TARGET=0.02
TRADER_VOLATILITY_HARD_LIMIT=0.08
TRADER_FEATURE_CORRELATION_THRESHOLD=0.60
TRADER_API_TIMEOUT_SECONDS=20
TRADER_MARKETDATA_RETRIES=2

TRADER_LIVE_TRADING_ENABLED=false
TRADER_STATE_DIR=.agent_state

